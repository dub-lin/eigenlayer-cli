- name: Run anvil chain
  run: |
    nohup make start-anvil-with-contracts-deployed > nohup.out 2>&1 &
    # Wait for anvil to be ready
    for i in {1..20}; do
      if nc -z localhost 8545; then
        echo "Anvil is up!"
        break
      fi
      echo "Waiting for anvil..."
      sleep 2
    done
